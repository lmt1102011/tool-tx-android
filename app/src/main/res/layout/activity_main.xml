<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false" />

    <FrameLayout
        android:id="@+id/nav_wrap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom"
        android:background="@color/surfaceContainer"
        android:fitsSystemWindows="false">

        <View
            android:id="@+id/nav_pill"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="17dp"
            android:background="@drawable/bg_pill" />

        <LinearLayout
            android:id="@+id/nav_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_item_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_home"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAutofill="no"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/nav_label_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_home"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_topup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_topup"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAutofill="no"
                    android:src="@drawable/ic_topup" />

                <TextView
                    android:id="@+id/nav_label_topup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_topup"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_tool"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_tool"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAutofill="no"
                    android:src="@drawable/ic_tool" />

                <TextView
                    android:id="@+id/nav_label_tool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_tool"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAutofill="no"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/nav_label_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_settings"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_item_admin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_admin"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAutofill="no"
                    android:src="@drawable/ic_bug" />

                <TextView
                    android:id="@+id/nav_label_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/nav_admin"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>