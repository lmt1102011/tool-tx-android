<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="8dp" android:right="8dp" android:top="2dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" android:width="30dp" />
            <solid android:color="@color/onSurfaceVariant" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" android:width="30dp" />
            <solid android:color="@color/onSurfaceVariant" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" android:width="30dp" />
            <solid android:color="@color/onSurfaceVariant" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>